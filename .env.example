TOWER_BUCKET=
GLUE_JOB_NAME=
REDSHIFT_COPY_ROLE=
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
