      {
        "name": "Metrics",
        "columns": [
          {
            "name": "Value",
            "dataType": "int64",
            "sourceColumn": "Value",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Metrics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Value=Int64.Type],{{1}})"
            }
          }
        ],
        "measures": [
          {
            "name": "Due orders",
            "expression": "CALCULATE(COUNTROWS(Orders),Orders[due]=1)",
            "formatString": "#,0",
            "displayFolder": "Service",
            "lineageTag": "3dc2c123-a564-5cb3-b892-b17f74960c43"
          },
          {
            "name": "OTIF orders",
            "expression": "CALCULATE(SUM(Orders[otif]),Orders[due]=1)",
            "formatString": "#,0",
            "displayFolder": "Service",
            "lineageTag": "cd35f282-d8e0-5900-bff9-a45cd6b9d9ba"
          },
          {
            "name": "OTIF",
            "expression": "DIVIDE([OTIF orders],[Due orders])",
            "formatString": "0.0%",
            "displayFolder": "Service",
            "lineageTag": "e0630acd-0c55-5666-95b1-aba3c71b99fe"
          },
          {
            "name": "First dispatch fill rate",
            "expression": "DIVIDE(CALCULATE(SUM(Orders[first_dispatch_qty]),Orders[due]=1), CALCULATE(SUM(Orders[ordered_qty]),Orders[due]=1))",
            "formatString": "0.0%",
            "displayFolder": "Service",
            "lineageTag": "cce5d4ba-19da-5b33-9f1e-264993681aa5"
          },
          {
            "name": "Open due orders",
            "expression": "CALCULATE(COUNTROWS(Orders),FILTER(Orders,Orders[due]=1 && Orders[delivered_qty]<Orders[ordered_qty]))",
            "formatString": "#,0",
            "displayFolder": "Service",
            "lineageTag": "daa95d0c-1832-5530-9443-57bacd25cb47"
          },
          {
            "name": "Transportation cost",
            "expression": "SUM(Shipments[transport_cost])",
            "formatString": "$#,0",
            "displayFolder": "Transport",
            "lineageTag": "87c1916e-27f3-5986-8758-c33abb1cc44c"
          },
          {
            "name": "Cost per shipped unit",
            "expression": "DIVIDE([Transportation cost],SUM(Shipments[shipped_qty]))",
            "formatString": "$0.00",
            "displayFolder": "Transport",
            "lineageTag": "82164027-bb85-5fa3-afa4-49081645d1d7"
          },
          {
            "name": "Average transit days",
            "expression": "AVERAGE(Shipments[transit_days])",
            "formatString": "0.0",
            "displayFolder": "Transport",
            "lineageTag": "4c57ef0f-dea2-5528-b7b8-5159534b6811"
          },
          {
            "name": "Transit day standard deviation",
            "expression": "STDEV.P(Shipments[transit_days])",
            "formatString": "0.0",
            "displayFolder": "Transport",
            "lineageTag": "3b6b4054-ffa0-5bb1-a6d9-f0a93cf98a93"
          },
          {
            "name": "Ending inventory value",
            "expression": "VAR LastDate=MAX(Inventory[snapshot_date]) RETURN CALCULATE(SUM(Inventory[inventory_value]),KEEPFILTERS(Inventory[snapshot_date]=LastDate))",
            "formatString": "$#,0",
            "displayFolder": "Inventory",
            "lineageTag": "e449802c-4388-59b4-b813-918416447b22"
          },
          {
            "name": "Average daily inventory value",
            "expression": "AVERAGEX(VALUES('Date'[date_day]),CALCULATE(SUM(Inventory[inventory_value])))",
            "formatString": "$#,0",
            "displayFolder": "Inventory",
            "lineageTag": "89cce71d-0133-5712-a488-14e83619fcaa"
          },
          {
            "name": "Period inventory turnover",
            "expression": "DIVIDE(SUM(Inventory[shipped_cogs]),[Average daily inventory value])",
            "formatString": "0.00x",
            "displayFolder": "Inventory",
            "lineageTag": "ae31234c-ad08-58a7-a618-09d3ea28ca31"
          },
          {
            "name": "Stockout SKU-days",
            "expression": "SUM(Inventory[stockout])",
            "formatString": "#,0",
            "displayFolder": "Inventory",
            "lineageTag": "b4cf07ee-9bf5-5030-b7d5-c5fb5b5b3b61"
          },
          {
            "name": "Stockout rate",
            "expression": "DIVIDE([Stockout SKU-days],COUNTROWS(Inventory))",
            "formatString": "0.0%",
            "displayFolder": "Inventory",
            "lineageTag": "1dcc1c4b-74b7-5a80-babb-4b1a5e48947e"
          },
          {
            "name": "Below safety SKU-days",
            "expression": "SUM(Inventory[below_safety])",
            "formatString": "#,0",
            "displayFolder": "Inventory",
            "lineageTag": "1fc30b5b-5885-5fcb-a9ea-2e7cf666a198"
          },
          {
            "name": "Available units",
            "expression": "VAR LastDate=MAX(Inventory[snapshot_date]) RETURN CALCULATE(SUM(Inventory[available_qty]),KEEPFILTERS(Inventory[snapshot_date]=LastDate))",
            "formatString": "#,0",
            "displayFolder": "Inventory",
            "lineageTag": "a3b7ce28-8431-5212-b108-50bfe8777cd3"
          },
          {
            "name": "Supplier OTIF",
            "expression": "DIVIDE(CALCULATE(SUM('Supplier receipts'[supplier_otif]),'Supplier receipts'[due]=1),CALCULATE(COUNTROWS('Supplier receipts'),'Supplier receipts'[due]=1))",
            "formatString": "0.0%",
            "displayFolder": "Suppliers",
            "lineageTag": "91bf8a1a-5885-5f08-92d5-08bebc9b3457"
          },
          {
            "name": "Average supplier lead days",
            "expression": "AVERAGE('Supplier receipts'[actual_lead_days])",
            "formatString": "0.0",
            "displayFolder": "Suppliers",
            "lineageTag": "6ab7f85b-0a25-56e4-aa8c-a3f0ffdfc6ff"
          },
          {
            "name": "Mean lead variance days",
            "expression": "AVERAGE('Supplier receipts'[lead_variance_days])",
            "formatString": "0.0",
            "displayFolder": "Suppliers",
            "lineageTag": "6dd5202c-0c71-5760-b9cc-d633bf8cf935"
          },
          {
            "name": "Supplier lead standard deviation",
            "expression": "STDEV.P('Supplier receipts'[actual_lead_days])",
            "formatString": "0.0",
            "displayFolder": "Suppliers",
            "lineageTag": "1c720ad9-7dce-5820-a80a-a966348a0f15"
          },
          {
            "name": "Demand units",
            "expression": "SUM(Demand[demand_qty])",
            "formatString": "#,0",
            "displayFolder": "Forecasting",
            "lineageTag": "8252a3c6-2d1b-5827-9b00-cfea46a74c25"
          },
          {
            "name": "Forecast units",
            "expression": "SUM(Forecasts[predicted_qty])",
            "formatString": "#,0.0",
            "displayFolder": "Forecasting",
            "lineageTag": "951d17c5-d668-56bc-8317-6cc9c1a4e00b"
          },
          {
            "name": "Forecast lower band",
            "expression": "SUM(Forecasts[lower_qty])",
            "formatString": "#,0.0",
            "displayFolder": "Forecasting",
            "lineageTag": "39db7fe0-b858-595b-addf-d8e3df302ba3"
          },
          {
            "name": "Forecast upper band",
            "expression": "SUM(Forecasts[upper_qty])",
            "formatString": "#,0.0",
            "displayFolder": "Forecasting",
            "lineageTag": "41c71c39-4f01-5ed1-9fc9-f47de01ec8a0"
          },
          {
            "name": "Backtest WAPE",
            "expression": "DIVIDE(SUMX(Backtests,ABS(Backtests[predicted_qty]-Backtests[actual_qty])),SUM(Backtests[actual_qty]))",
            "formatString": "0.0%",
            "displayFolder": "Forecasting",
            "lineageTag": "343cae30-666d-597f-8e62-34e8e12972da"
          },
          {
            "name": "Backtest MAE",
            "expression": "AVERAGEX(Backtests,ABS(Backtests[predicted_qty]-Backtests[actual_qty]))",
            "formatString": "0.0",
            "displayFolder": "Forecasting",
            "lineageTag": "445acb8d-d589-5be0-bebd-81847a302984"
          },
          {
            "name": "Backtest bias",
            "expression": "DIVIDE(SUM(Backtests[predicted_qty])-SUM(Backtests[actual_qty]),SUM(Backtests[actual_qty]))",
            "formatString": "0.0%",
            "displayFolder": "Forecasting",
            "lineageTag": "6ade1327-9798-5774-a0d4-ec7530d7b6f5"
          },
          {
            "name": "Anomaly alerts",
            "expression": "COUNTROWS(Anomalies)",
            "formatString": "#,0",
            "displayFolder": "Anomalies",
            "lineageTag": "f0b59da1-b803-5c3e-8204-986c272f9f4f"
          },
          {
            "name": "High severity alerts",
            "expression": "CALCULATE(COUNTROWS(Anomalies),Anomalies[severity]=\"high\")",
            "formatString": "#,0",
            "displayFolder": "Anomalies",
            "lineageTag": "9c1c7990-65e2-5e3a-a13f-3343183da95e"
          },
          {
            "name": "Warehouse context",
            "expression": "SELECTEDVALUE(Warehouse[warehouse_id],\"All authorized warehouses\")",
            "formatString": "",
            "displayFolder": "Context",
            "lineageTag": "579879a6-f291-580a-b287-d4f7fdf1be80"
          }
        ]
      },
