        "name": "d8672e98-7e5c-5930-8205-75cb40654ee1",
        "fromTable": "Orders",
        "fromColumn": "promised_date",
        "toTable": "Date",
        "toColumn": "date_day",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "6a2f2d57-1d06-5bed-9920-f574cd7c7957",
        "fromTable": "Inventory",
        "fromColumn": "snapshot_date",
        "toTable": "Date",
        "toColumn": "date_day",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "f1e060fe-ad4d-5e39-9cee-cb29a8be794e",
        "fromTable": "Demand",
        "fromColumn": "date_day",
        "toTable": "Date",
        "toColumn": "date_day",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "11d4f157-2502-5c31-b201-57983d896b01",
        "fromTable": "Shipments",
        "fromColumn": "shipped_date",
        "toTable": "Date",
        "toColumn": "date_day",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "dab088f7-5668-56e5-9ddb-d4522548a301",
        "fromTable": "Supplier receipts",
        "fromColumn": "expected_date",
        "toTable": "Date",
        "toColumn": "date_day",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "b8ede84b-2b72-5008-afc1-82ffc5dac058",
        "fromTable": "Backtests",
        "fromColumn": "target_date",
        "toTable": "Date",
        "toColumn": "date_day",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "7d734a6a-8cef-514c-af78-41271a6d68ec",
        "fromTable": "Anomalies",
        "fromColumn": "date_day",
        "toTable": "Date",
        "toColumn": "date_day",
        "crossFilteringBehavior": "oneDirection"
      }
    ],
    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:\\supply-chain\\artifacts\" meta [IsParameterQuery=true,Type=\"Text\",IsParameterQueryRequired=true]"
      },
      {
        "name": "UseRedshift",
        "kind": "m",
        "expression": "false meta [IsParameterQuery=true,Type=\"Logical\",IsParameterQueryRequired=true]"
      },
      {
        "name": "RedshiftServer",
        "kind": "m",
        "expression": "\"YOUR_CLUSTER.region.redshift.amazonaws.com:5439\" meta [IsParameterQuery=true,Type=\"Text\",IsParameterQueryRequired=true]"
      },
      {
        "name": "RedshiftDatabase",
        "kind": "m",
        "expression": "\"analytics\" meta [IsParameterQuery=true,Type=\"Text\",IsParameterQueryRequired=true]"
      },
      {
        "name": "LoadMart",
        "kind": "m",
        "expression": "(tableName as text) as table =>\nlet\n Source = if UseRedshift then\n    let Connection=AmazonRedshift.Database(RedshiftServer,RedshiftDatabase),\n        Schema=Connection{[Name=\"analytics\",Kind=\"Schema\"]}[Data],\n        Fact=Schema{[Name=tableName,Kind=\"Table\"]}[Data]\n    in Fact\n else Table.PromoteHeaders(Csv.Document(File.Contents(DataFolder & \"/\" & tableName & \".csv\"),\n     [Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),[PromoteAllScalars=true]),\n Clean=Table.ReplaceValue(Source,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Source))\nin Clean"
      }
    ],
    "roles": [
      {
        "name": "Warehouse Analyst",
        "modelPermission": "read",
        "tablePermissions": [
          {
            "name": "Warehouse",
            "filterExpression": "CONTAINS(FILTER(UserWarehouse,UserWarehouse[upn]=USERPRINCIPALNAME()),UserWarehouse[warehouse_id],Warehouse[warehouse_id])"
          },
          {
            "name": "UserWarehouse",
            "filterExpression": "UserWarehouse[upn]=USERPRINCIPALNAME()"
          }
        ]
      }
    ]
  }
}
